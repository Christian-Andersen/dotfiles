font-size = 14
background = #000000
maximize = true
gtk-titlebar = false
cursor-style = bar
shell-integration-features = no-cursor
window-decoration = false
window-padding-x = 4
window-padding-y = 0
keybind = ctrl+enter=unbind
window-inherit-working-directory = false

# experimental keybinds
keybind = alt+n=new_split:right
keybind = alt+b=new_split:down
keybind = alt+w=new_tab
keybind = alt+q=previous_tab
keybind = alt+e=next_tab
keybind = alt+x=close_surface
keybind = alt+h=goto_split:left
keybind = alt+l=goto_split:right
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+f=toggle_split_zoom
keybind = alt+1=goto_tab:1
keybind = alt+2=goto_tab:2
keybind = alt+3=goto_tab:3
keybind = alt+4=goto_tab:4
keybind = alt+5=goto_tab:5
keybind = alt+6=goto_tab:6
keybind = alt+7=goto_tab:7
keybind = alt+8=goto_tab:8
keybind = alt+9=goto_tab:9
