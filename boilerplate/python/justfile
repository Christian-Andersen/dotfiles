set dotenv-load

[private]
default:
    @just --list

check:
    uv run -- prek run --all-files --no-group slow

audit:
    uv run -- prek run audit --all-files

test:
    uv run -- prek run test --all-files --verbose

ci:
    uv run -- prek run --all-files

run *args:
    uv run -- main.py {{ args }}
